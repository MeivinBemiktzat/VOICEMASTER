# Hugging Face Storage Bucket
HF_S3_ACCESS_KEY_ID=HFAK...
HF_S3_SECRET_ACCESS_KEY=...
HF_STORAGE_NAMESPACE=YOUR_HUGGINGFACE_USERNAME_OR_ORG
HF_STORAGE_BUCKET=voicemaster-data
HF_S3_REGION=us-east-1
HF_S3_ENDPOINT=https://s3.hf.co

# Long random secret used to sign the VoiceMaster browser session cookie.
# Generate a new value; do not reuse an example value.
VOICEMASTER_SESSION_SECRET=replace-with-a-long-random-secret
